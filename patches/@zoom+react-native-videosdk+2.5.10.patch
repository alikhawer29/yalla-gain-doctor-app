+
+export class ZoomVideoSdkBroadcastStreamingViewer {
+  async joinStreaming(ctx) {
+    return await RNZoomVideoSdkBroadcastStreamingViewer.joinStreaming(ctx);
+  }
+  async leaveStreaming() {
+    return await RNZoomVideoSdkBroadcastStreamingViewer.leaveStreaming();
+  }
+  async getStreamingJoinStatus() {
+    return await RNZoomVideoSdkBroadcastStreamingViewer.getStreamingJoinStatus();
+  }
+}
